@inherits LayoutComponentBase

<div class="flex min-h-screen bg-slate-50 font-sans">
    <!-- Sidebar navigation -->
    <aside class="w-64 bg-white border-r border-slate-200 flex-shrink-0 min-h-screen sticky top-0 h-screen overflow-y-auto">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 min-h-screen bg-slate-50">
        <div class="p-8 max-w-7xl w-full mx-auto">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 right-4 bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-lg shadow-lg z-50 text-sm">
    An unhandled error has occurred.
    <a href="" class="reload underline font-medium ml-2">Reload</a>
    <a class="dismiss cursor-pointer ml-2">✕</a>
</div>