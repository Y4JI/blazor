@using POSProductDashboard.Models

@if (IsOpen && ProductToEdit != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] z-50 flex items-center justify-center p-4" @onclick="HandleBackdropClick">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-lg w-full p-6 text-left transform transition-all" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <h3 class="text-base font-bold text-slate-900">Edit Product</h3>
                <button type="button" @onclick="Close" class="text-slate-400 hover:text-slate-600 transition-colors p-1" aria-label="Close modal">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m15 9-6 6M9 9l6 6" />
                    </svg>
                </button>
            </div>

            <!-- Form Content -->
            <div class="mt-5 space-y-4">
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="p-3 text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg">
                        @ErrorMessage
                    </div>
                }

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">UPC (Barcode)</label>
                    <input type="text"
                           @bind="ProductToEdit.UPC"
                           placeholder="UPC Barcode"
                           class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Product Description</label>
                    <input type="text"
                           @bind="ProductToEdit.Description"
                           placeholder="Product Description"
                           class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Cost ($)</label>
                        <input type="number"
                               step="0.01"
                               min="0"
                               @bind="ProductToEdit.Cost"
                               class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Selling Price ($)</label>
                        <input type="number"
                               step="0.01"
                               min="0"
                               @bind="ProductToEdit.SellingPrice"
                               class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Status</label>
                    <div class="relative">
                        <select @bind="ProductToEdit.Status"
                                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-colors appearance-none pr-10">
                            <option value="Active">Active</option>
                            <option value="Needs Review">Needs Review</option>
                            <option value="Draft">Draft</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 pt-6 mt-6 border-t border-slate-100">
                <button type="button"
                        @onclick="Close"
                        class="px-4 py-2 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button type="button"
                        @onclick="Save"
                        class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-sm font-medium text-white rounded-lg shadow-sm transition-colors">
                    Update Product
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Product? Product { get; set; }
    [Parameter] public EventCallback<Product> OnUpdate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Product? ProductToEdit;
    private string? ErrorMessage;

    protected override void OnParametersSet()
    {
        if (IsOpen && Product != null)
        {
            ProductToEdit = Product.Clone();
            ErrorMessage = null;
        }
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private async Task Close()
    {
        ErrorMessage = null;
        await OnCancel.InvokeAsync();
    }

    private async Task Save()
    {
        if (ProductToEdit == null) return;

        if (string.IsNullOrWhiteSpace(ProductToEdit.UPC))
        {
            ErrorMessage = "Please enter a valid UPC.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ProductToEdit.Description))
        {
            ErrorMessage = "Please enter a product description.";
            return;
        }

        if (ProductToEdit.SellingPrice <= 0)
        {
            ErrorMessage = "Selling price must be greater than 0.";
            return;
        }

        ErrorMessage = null;
        await OnUpdate.InvokeAsync(ProductToEdit);
    }
}
