@page "/delete-product-modal"
@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Delete Product Modal - CorePOS</PageTitle>

<!-- We render the Products page in background and open the Delete Product modal preloaded with the Figma sample product -->
<div class="relative">
    <div class="opacity-40 pointer-events-none select-none filter blur-[1px]">
        <Products />
    </div>

    <DeleteProductModal IsOpen="true"
                        ProductToDelete="SampleProduct"
                        OnDeleteConfirmed="HandleDeleteConfirmed"
                        OnCancel="HandleCancel" />
</div>

@code {
    private Product SampleProduct = new Product
    {
        UPC = "849888042566",
        Description = "Coca-Cola Classic 12oz",
        Cost = 0.89m,
        SellingPrice = 1.49m,
        Status = "Active"
    };

    private void HandleDeleteConfirmed(Product product)
    {
        ProductService.Delete(product.UPC);
        Navigation.NavigateTo("products");
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo("products");
    }
}
