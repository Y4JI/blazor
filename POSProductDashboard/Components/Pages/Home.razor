@page "/"
@page "/dashboard"
@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Dashboard Overview - CorePOS</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight focus:outline-none">Dashboard Overview</h1>
        <p class="text-sm text-slate-500 mt-1">Real-time operations summary and active catalog status.</p>
    </div>

    <!-- Metric Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Total Companies -->
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 hover:shadow-md transition-shadow">
            <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Companies</span>
            <div class="text-3xl font-bold text-slate-900 mt-2">@ProductService.TotalCompanies</div>
        </div>

        <!-- Total Products -->
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 hover:shadow-md transition-shadow">
            <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Products</span>
            <div class="text-3xl font-bold text-slate-900 mt-2">@ProductService.GetDisplayTotalProducts().ToString("N0")</div>
        </div>

        <!-- Needs Review -->
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Needs Review</span>
                <span class="bg-amber-50 text-amber-700 border border-amber-200/60 text-[11px] font-semibold px-2 py-0.5 rounded-full">
                    Needs Review
                </span>
            </div>
            <div class="text-3xl font-bold text-slate-900 mt-2">@ProductService.GetDisplayNeedsReviewCount()</div>
        </div>
    </div>

    <!-- Recent Products Table Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm overflow-hidden">
        <!-- Card Header -->
        <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-900">Recent Products</h2>
            <a href="products" class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 rounded-lg text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                <span>View All Products</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </a>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="py-3 px-6 text-xs font-semibold text-slate-400 uppercase tracking-wider w-48">UPC</th>
                        <th class="py-3 px-6 text-xs font-semibold text-slate-400 uppercase tracking-wider">Description</th>
                        <th class="py-3 px-6 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right w-36">Price</th>
                        <th class="py-3 px-6 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center w-36">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var product in RecentProducts)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="py-4 px-6 text-xs font-mono font-medium text-slate-500 whitespace-nowrap">
                                @product.UPC
                            </td>
                            <td class="py-4 px-6 text-sm font-medium text-slate-900">
                                @product.Description
                            </td>
                            <td class="py-4 px-6 text-sm font-semibold text-slate-900 text-right whitespace-nowrap">
                                $@product.SellingPrice.ToString("F2")
                            </td>
                            <td class="py-4 px-6 text-center whitespace-nowrap">
                                @if (product.Status == "Active")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600">
                                        Active
                                    </span>
                                }
                                else if (product.Status == "Needs Review")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-600">
                                        Needs Review
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                        @product.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Product> RecentProducts = new();

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        RecentProducts = ProductService.GetRecent(5);
    }
}
